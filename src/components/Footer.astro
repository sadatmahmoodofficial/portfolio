---
const currentYear = new Date().getFullYear();
---

<footer id="contact" class="border-t border-neutral-900 py-16 px-6 bg-neutral-950">
  <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
    <div>
      <h3 class="text-2xl font-bold text-white mb-2">Let's build something together.</h3>
      <p class="text-sm text-neutral-400 max-w-md">
        Available for full-stack engineering, mobile development, or end-to-end product design and content consultation.
      </p>
    </div>

    <div class="flex flex-wrap gap-4 text-sm font-medium">
      <a 
        href="mailto:sadatmahmoodofficial@gmail.com" 
        class="px-5 py-2.5 rounded-lg bg-white text-neutral-950 hover:bg-neutral-200 transition-colors"
      >
        Email Me
      </a>
      <a 
        href="https://github.com/sadatmahmoodofficial" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="px-5 py-2.5 rounded-lg border border-neutral-800 bg-neutral-900/50 hover:bg-neutral-800 text-neutral-200 transition-colors"
      >
        GitHub ↗
      </a>
      <a 
        href="https://www.linkedin.com/in/sadat-mahmood-saurov/" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="px-5 py-2.5 rounded-lg border border-neutral-800 bg-neutral-900/50 hover:bg-neutral-800 text-neutral-200 transition-colors"
      >
        LinkedIn ↗
      </a>
    </div>
  </div>

  <div class="max-w-5xl mx-auto pt-12 mt-12 border-t border-neutral-900 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-600">
    <p>© {currentYear} Sadat Mahmood Saurov. All rights reserved.</p>
    <p>Engineered with Astro & Tailwind CSS.</p>
  </div>
</footer>