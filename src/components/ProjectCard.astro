---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="group rounded-2xl border border-slate-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/40 p-8 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
  <div>
    {project.image && (
    <div class="mb-6 rounded-xl overflow-hidden border border-slate-200 dark:border-neutral-800 bg-slate-100 dark:bg-neutral-950 aspect-video">
        <img 
        src={project.image} 
        alt={project.title} 
        class="w-full h-full object-cover group-hover:scale-105 transition duration-500" 
        loading="lazy" 
        />
    </div>
    )}
    <div class="flex items-center justify-between text-xs mb-4">
      <span class="px-2.5 py-1 rounded-md font-semibold tracking-wide uppercase text-[11px] bg-slate-100 dark:bg-neutral-800 text-slate-700 dark:text-neutral-300">
        {project.category}
      </span>
      <span class="text-slate-500 dark:text-neutral-400 font-medium">{project.role}</span>
    </div>

    <h3 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white mb-2 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
      {project.title}
    </h3>
    <p class="text-sm font-semibold text-slate-700 dark:text-neutral-300 mb-3 leading-snug">
      {project.tagline}
    </p>
    <p class="text-sm text-slate-600 dark:text-neutral-400 leading-relaxed mb-6">
      {project.description}
    </p>

    <div class="mb-6 p-4 rounded-xl bg-slate-50 dark:bg-neutral-950/50 border border-slate-200/80 dark:border-neutral-800/80">
      <h4 class="text-[11px] uppercase tracking-wider font-bold text-slate-500 dark:text-neutral-400 mb-2">Key Highlights</h4>
      <ul class="space-y-1.5">
        {project.highlights.map((item) => (
          <li class="text-xs text-slate-700 dark:text-neutral-300 flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 shrink-0"></span>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div>
    <div class="flex flex-wrap gap-2 pt-4 border-t border-slate-100 dark:border-neutral-800 mb-6">
      {project.stack.map((tech) => (
        <span class="px-2.5 py-1 text-xs rounded-lg font-medium bg-slate-100 dark:bg-neutral-800 text-slate-700 dark:text-neutral-300">
          {tech}
        </span>
      ))}
    </div>

    <div class="flex items-center gap-4 text-sm font-semibold">
      {project.liveUrl && (
        <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="text-indigo-600 dark:text-indigo-400 hover:underline">
          Visit Live Demo ↗
        </a>
      )}
    </div>
  </div>
</article>