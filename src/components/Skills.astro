---
interface SkillCategory {
  title: string;
  description: string;
  skills: string[];
}

const skillCategories: SkillCategory[] = [
  {
    title: "Full-Stack Web Development",
    description: "Architecting fast, responsive web applications and APIs backed by scalable data layers.",
    skills: [
      "Next.js",
      "Astro",
      "React",
      "Tailwind CSS",
      "TypeScript",
      "FastAPI",
      "Supabase",
      "Cloudflare Pages"
    ]
  },
  {
    title: "Mobile App Engineering",
    description: "Building polished cross-platform applications with robust state handling and hardware integration.",
    skills: [
      "Flutter",
      "Dart",
      "Firebase / Firestore",
      "State Management",
      "RESTful APIs",
      "OCR & Sensors",
      "Cross-Platform UI"
    ]
  },
  {
    title: "Product Design & Content Strategy",
    description: "Translating ambiguous requirements into intuitive user journeys, clean UX systems, and clear copy.",
    skills: [
      "User Journey Mapping",
      "Wireframing & UX Flow",
      "Design Systems",
      "Content Architecture",
      "Technical Copywriting",
      "Sanity CMS Architecture",
      "Accessibility (a11y)"
    ]
  }
];
---

<section id="skills" class="py-24 px-6 max-w-5xl mx-auto border-t border-black/5 dark:border-white/10">
  <div class="mb-12">
    <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 mb-2">Capabilities</h2>
    <p class="text-3xl font-bold text-neutral-900 dark:text-white tracking-tight">Core toolkit & disciplines</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {skillCategories.map((category) => (
      <div class="p-6 rounded-2xl border border-black/8 dark:border-white/10 bg-white/60 dark:bg-neutral-900/40 backdrop-blur-md flex flex-col justify-between hover:border-black/15 dark:hover:border-white/20 transition-colors">
        <div>
          <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-2">{category.title}</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed mb-6">{category.description}</p>
        </div>

        <div class="flex flex-wrap gap-2 pt-4 border-t border-black/5 dark:border-white/10">
          {category.skills.map((skill) => (
            <span class="px-2.5 py-1 text-xs rounded-lg font-medium bg-neutral-100 dark:bg-neutral-800/60 text-neutral-700 dark:text-neutral-300 border border-black/5 dark:border-white/5">
              {skill}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>