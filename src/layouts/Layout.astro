---
import '../styles/global.css';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Sadat Mahmood Saurov — Product Developer & Engineer", 
  description = "Full-stack engineer with hands-on expertise in product design and content writing." 
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      // Default to dark unless explicitly toggled to light
      const storedTheme = typeof localStorage !== 'undefined' ? localStorage.getItem('theme') : null;
      if (storedTheme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 dark:bg-neutral-950 text-slate-900 dark:text-neutral-100 bg-grid-pattern transition-colors duration-200 antialiased selection:bg-indigo-500 selection:text-white">
    <slot />
    <SpeedInsights />
  </body>
</html>