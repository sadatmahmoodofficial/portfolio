---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Skills from '../components/Skills.astro';
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';
import { projects } from '../data/projects';
---

<Layout>
  <Navbar />
  <main class="flex-grow">
    <Hero />

    <section id="projects" class="py-20 px-6 max-w-5xl mx-auto border-t border-neutral-900">
      <div class="mb-12">
        <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 mb-2">Featured Work</h2>
        <p class="text-3xl font-bold text-white tracking-tight">Production applications & systems</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </section>

    <Skills />
    <About />
  </main>
  <Footer />
</Layout>